[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://config/service_menu.gd" id="1_menu"]
[ext_resource type="PackedScene" path="res://control.tscn" id="2_monitor"]
[ext_resource type="Script" path="res://config/hardware_page.gd" id="3_hardware"]
[ext_resource type="Script" path="res://config/av_page.gd" id="4_av"]

[node name="ServiceMenu" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="TopBar" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="TopBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "  Service menu"

[node name="QuitButton" type="Button" parent="TopBar"]
