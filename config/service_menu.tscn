[node name="ExitButton" type="Button" parent="TopBar"]
custom_minimum_size = Vector2(180, 56)
layout_mode = 2
text = "Exit ✕"

[node name="Tabs" type="TabContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
current_tab = 0

[node name="Monitor" parent="Tabs" instance=ExtResource("2_monitor")]
layout_mode = 2
metadata/_tab_index = 0

[node name="Hardware" type="MarginContainer" parent="Tabs"]
layout_mode = 2
